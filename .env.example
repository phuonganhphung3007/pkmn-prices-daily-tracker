# Copy this file to .env and fill in your key. python-dotenv loads it
# automatically, which sidesteps PowerShell's $env:VAR not persisting
# across sessions.
PKMNPRICES_API_KEY=pk_your_key_here

# Optional: host pokemon.db on Turso as an embedded replica (local file for
# speed, synced with a remote libSQL database). Leave both unset to use a
# plain local SQLite file with no networking -- fine for local dev/testing.
# Get these from `turso db show <name> --url` and `turso db tokens create <name>`.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=your_token_here

# Optional overrides:
# PKMNPRICES_DAILY_LIMIT=500
# PKMNPRICES_SAFETY_BUFFER=10
# PKMNPRICES_DB_PATH=data/pokemon.db
