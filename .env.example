# Copy this file to .env and fill in your key. python-dotenv loads it
# automatically, which sidesteps PowerShell's $env:VAR not persisting
# across sessions.
PKMNPRICES_API_KEY=pk_your_key_here

# Optional overrides:
# PKMNPRICES_DAILY_LIMIT=500
# PKMNPRICES_SAFETY_BUFFER=10

# BigQuery. Leave GCP_PROJECT_ID unset to skip BigQuery and write CSV only.
# Locally, authenticate once with: gcloud auth application-default login
GCP_PROJECT_ID=your-gcp-project-id
# BQ_DATASET=pkmnprices
# BQ_CARDS_TABLE=cards
# BQ_PRICE_HISTORY_TABLE=price_history
# BQ_LOCATION=US
